{
  "formatVersion": 1,
  "classification": "local-contract-runtime-pending",
  "family": "a3-workspace",
  "physicalInventory": {
    "common": {
      "_sync_operation_state": [
        "workspace_context:TEXT:NOT_NULL:DEFAULT_EMPTY",
        "reserved_entries:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "reserved_bytes:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "snapshot_stage_entries:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "snapshot_stage_bytes:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "snapshot_cleanup_ordinal:INTEGER:NONNEGATIVE:DEFAULT_ZERO"
      ],
      "_sync_apply_plan": [
        "operation_kind:TEXT:pull|settlement|snapshot|conflict",
        "preserve_schema:TEXT:NOT_NULL:DEFAULT_EMPTY",
        "preserve_table:TEXT:NOT_NULL:DEFAULT_EMPTY",
        "preserve_key:TEXT:NOT_NULL:DEFAULT_EMPTY",
        "atomic_work:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "preservation_complete:INTEGER:BOOLEAN:DEFAULT_ZERO"
      ],
      "_sync_apply_rows": [
        "role:TEXT:intended|survivor|exception",
        "owner_revision:INTEGER:NONNEGATIVE:DEFAULT_ZERO"
      ],
      "_sync_snapshot_stage": [
        "charge:INTEGER:NONNEGATIVE:DEFAULT_ZERO"
      ]
    },
    "goOnly": {
      "_sync_operation_state": [
        "push_stage_entries:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "push_stage_bytes:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "push_cleanup_ordinal:INTEGER:NONNEGATIVE:DEFAULT_ZERO"
      ],
      "_sync_push_stage": [
        "charge:INTEGER:NONNEGATIVE:DEFAULT_ZERO"
      ]
    },
    "kotlinOnly": {
      "_sync_apply_plan": [
        "source_snapshot_id:TEXT:NOT_NULL:DEFAULT_EMPTY"
      ],
      "_sync_apply_rows": [
        "role:TEXT:ADDITIONAL_snapshot_ref",
        "source_ordinal:INTEGER:POSITIVE_FOR_snapshot_ref"
      ],
      "_sync_operation_state": [
        "snapshot_staged_row_count:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "snapshot_staged_byte_count:INTEGER:NONNEGATIVE:DEFAULT_ZERO",
        "snapshot_stage_guard:TEXT:NOT_NULL:DEFAULT_EMPTY"
      ]
    },
    "indexes": [
      "_sync_apply_rows_role_ordinal_idx(role,ordinal)"
    ],
    "reservationOwner": "existing-lifetime-admission-and-operation-owner",
    "reclamation": "only-new-lifetime-acquisition-after-prior-owner-ended",
    "stageCharge": "64 + 6 * UTF8(identity_strings) + UTF8(payload)",
    "stageMaintenance": {
      "commonTriggers": [
        "_sync_snapshot_stage_charge_insert",
        "_sync_snapshot_stage_charge_update",
        "_sync_snapshot_stage_charge_delete"
      ],
      "goOnlyTriggers": [
        "_sync_push_stage_charge_insert",
        "_sync_push_stage_charge_update",
        "_sync_push_stage_charge_delete"
      ],
      "mutations": "writer-atomic exact stored charge and owner totals; checked INTEGER overflow rejects the statement"
    },
    "workspaceContextEncoding": {
      "empty": "empty TEXT when no reservation",
      "active": "JSON array in allocation order",
      "recordFields": [
        "token",
        "unit",
        "context",
        "entries",
        "bytes"
      ],
      "identity": "token, unit and context are exact lowercase 64-hex strings",
      "counts": "nonnegative signed int64; totals equal reserved owner counters",
      "reclamation": "fresh lifetime lease acquisition only; client or invocation open never reclaims"
    },
    "reservationBinding": [
      "database",
      "service",
      "account",
      "attachment_epoch",
      "source",
      "generation",
      "fingerprint",
      "physical_shape",
      "registration_fk_order",
      "dirty_revision",
      "baseline_revision",
      "checkpoint",
      "next_source_bundle_id",
      "outbox_identity",
      "effective_limits"
    ],
    "snapshotPayloadOwnership": {
      "kotlin": "completed _sync_snapshot_stage owns authoritative payload; _sync_apply_rows holds payload-free snapshot references and distinct local overrides or exceptions; _sync_apply_plan binds the stage id",
      "go": "implementation-specific retained representation; no physical parity implied",
      "shared": "original snapshot input remains authoritative for A; local preservation may override business view"
    }
  },
