      "executed": false
    },
    {
      "id": "generation-publication",
      "owner": "baseline-lifecycle",
      "given": "Target generation installed through existing ready workflow",
      "expected": "Old intent resolved/drained; target A complete before ready; no old-layout migration",
      "executed": false
    },
    {
      "id": "conflict-pending",
      "owner": "baseline-lifecycle",
      "given": "Defer or dependency/base evidence unavailable",
