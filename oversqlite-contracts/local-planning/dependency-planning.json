      "executed": false
    },
    {
      "id": "rekey-unrelated-insert",
      "owner": "dependency-planning",
      "given": "Unrelated DELETE P and INSERT Q have the same persisted facts as a no-dependent rekey",
      "expected": "Identical selection; do not infer pairing from payload, ordinal adjacency or transaction history",
      "executed": false
    },
    {
      "id": "rekey-chain-coalescing",
      "owner": "baseline-lifecycle",
      "given": "P to Q to R with unpublished Q; also repeat with Q published or frozen ambiguously",
      "expected": "Prune only proven unpublished no-op Q; retain published Q deletion or exact frozen replay; preserve each identity B without transferring bases",
      "executed": false
    },
    {
      "id": "rekey-restart",
      "owner": "baseline-lifecycle",
      "given": "Reopen before freeze, after an independent old-delete freeze/commit and during requeue, including chained rekey",
      "expected": "Reconstruct actual FK graph from persisted facts only; exact outbox replay first; remaining intent and B survive without pairing state",
      "executed": false
    },
    {
      "id": "rekey-partial-failure",
      "owner": "public-sync-live",
      "given": "One-row batches: no-dependent delete P commits and insertion Q then conflicts or fails validation",
