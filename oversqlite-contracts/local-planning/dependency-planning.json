  "runtimeScenarios": [
    {
      "id": "attach-unpublished",
      "owner": "baseline-lifecycle",
      "given": "Local existing row first adopted, before publication",
      "expected": "A=unpublished; B=absent never_published; full L and desired edges only",
      "executed": false
    },
    {
      "id": "local-reparent",
      "owner": "baseline-lifecycle",
      "given": "A C->P; edit C->Q; delete C locally",
      "expected": "A edge remains C->P; first full B unchanged; desired edges become empty",
      "executed": false
    },
    {
      "id": "typed-base",
      "owner": "baseline-lifecycle",
      "given": "Edit non-FK scalar with int64/blob/null/JSON/generated columns",
      "expected": "B retains every typed column exactly; JSON atomic; local edits do not change A",
      "executed": false
    },
    {
      "id": "rekey",
      "owner": "dependency-planning",
      "given": "Rekey P to Q and reparent surviving C",
      "expected": "Only actual FK edges: delete P requires reparent C, which requires insert Q; no synthetic P/Q link or whole-closure grouping",
      "executed": false
    },
    {
      "id": "noop",
      "owner": "baseline-lifecycle",
      "given": "Never-published insert then delete without outbox",
      "expected": "Clear matching dirty B/desired edges only; no push or source ID advance",
      "executed": false
    },
    {
      "id": "freeze-reopen",
      "owner": "baseline-lifecycle",
      "given": "Freeze then lose response and reopen",
      "expected": "Outbox contains original B/L/wire/hash; replay first; no new identity",
      "executed": false
    },
    {
      "id": "edit-during-outbox",
      "owner": "baseline-lifecycle",
      "given": "Edit same key while immutable outbox waits",
      "expected": "Frozen B unchanged; newer dirty B copied from current A; both survive restart",
      "executed": false
    },
    {
      "id": "settlement-rebase",
      "owner": "baseline-lifecycle",
      "given": "Committed normalized S while newer local L must survive",
      "expected": "A=S; remaining affected B=S; L retained; source/checkpoint atomic; no double advance",
      "executed": false
    },
    {
      "id": "extra-effect",
      "owner": "baseline-lifecycle",
      "given": "Committed extra child effect plus trigger disturbs unrelated dirty row",
      "expected": "Affected A from wire; full B rebase only for affected intent; unrelated B/L preserved",
      "executed": false
    },
    {
      "id": "requeue-newer",
      "owner": "baseline-lifecycle",
      "given": "Definitive rejection then requeue with newer dirty L",
      "expected": "Original historical B preserved; newer L wins; no A update absent explicit rebase",
      "executed": false
    },
    {
      "id": "pull-version-skip",
      "owner": "baseline-lifecycle",
      "given": "Older bundle for row with newer installed A",
      "expected": "A/B/server edges never regress; original hash validated; checkpoint sequential",
      "executed": false
    },
    {
      "id": "tombstone",
      "owner": "baseline-lifecycle",
      "given": "Confirmed delete and later reinsertion",
      "expected": "A tombstone version retained; no fabricated absent version; retry B retains deletion provenance",
      "executed": false
    },
    {
      "id": "snapshot-clean",
      "owner": "baseline-lifecycle",
